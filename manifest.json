{
  "manifest_version": 3,
  "name": "JSON Lens",
  "version": "1.1.0",
  "description": "Fast JSON and CSV viewer: syntax colours, virtualized rendering, and a jq filter box.",
  "minimum_chrome_version": "128",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "csv", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jq.js", "viewer.js"],
      "run_at": "document_idle"
    }
  ]
}
